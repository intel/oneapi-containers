FROM rockylinux/rockylinux:10

ARG DEEP_LEARNING_ESSENTIALS_VERSION="2026.2.0-631.x86_64"

# Install dependencies for Intel® oneAPI Libraries
RUN dnf update -y && \
    dnf install -y --allowerasing \
        cmake procps make gcc gcc-c++ kernel-devel pkgconfig which bzip2 openssh-server openssh-clients wget net-tools git diffutils && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# repository to install Intel® oneAPI Libraries
RUN echo $'\
[oneAPI]\n\
name=Intel(R) oneAPI repository\n\
baseurl=https://yum.repos.intel.com/oneapi\n\
enabled=1\n\
gpgcheck=1\n\
repo_gpgcheck=1\n\
gpgkey=https://yum.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB' \
> /etc/yum.repos.d/oneAPI.repo

# repository to install Intel® GPU drivers
RUN dnf install -y 'dnf-command(config-manager)' && \
    dnf config-manager --set-enabled crb && \
    dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm && \
    dnf clean all && \
    rm -rf /var/cache/yum && \
    /usr/bin/crb enable

RUN dnf update -y && dnf install -y \
        intel-deep-learning-essentials-${DEEP_LEARNING_ESSENTIALS_VERSION} intel-compute-runtime intel-level-zero-devel oneapi-level-zero && \
    dnf clean all && \
    rm -rf /var/cache/yum/*

ENV LANG="C.UTF-8"

ENV CCL_CONFIGURATION='cpu_gpu_dpcpp'
ENV CCL_CONFIGURATION_PATH=''
ENV CCL_ROOT='/opt/intel/oneapi/ccl/2022.2'
ENV CMAKE_PREFIX_PATH='/opt/intel/oneapi/tbb/2023.2/env/..:/opt/intel/oneapi/pti/1.2/lib/cmake/pti:/opt/intel/oneapi/mkl/2026.2/lib/cmake:/opt/intel/oneapi/dpl/2022.14/lib/cmake/oneDPL:/opt/intel/oneapi/compiler/2026.2:/opt/intel/oneapi/ccl/2022.2/lib/cmake/oneCCL'
ENV CMPLR_ROOT='/opt/intel/oneapi/compiler/2026.2'
ENV CPATH='/opt/intel/oneapi/umf/1.2/include:/opt/intel/oneapi/libfabric/2.6/include:/opt/intel/oneapi/dev-utilities/2026.2/include:/opt/intel/oneapi/ccl/2022.2/include'
ENV CPLUS_INCLUDE_PATH='/opt/intel/oneapi/umf/1.2/include:/opt/intel/oneapi/tcm/1.6/env/../include:/opt/intel/oneapi/tbb/2023.2/env/../include:/opt/intel/oneapi/pti/1.2/include:/opt/intel/oneapi/mkl/2026.2/include:/opt/intel/oneapi/dpl/2022.14/include'
ENV C_INCLUDE_PATH='/opt/intel/oneapi/umf/1.2/include:/opt/intel/oneapi/tcm/1.6/env/../include:/opt/intel/oneapi/tbb/2023.2/env/../include:/opt/intel/oneapi/pti/1.2/include:/opt/intel/oneapi/mkl/2026.2/include'
ENV DIAGUTIL_PATH='/opt/intel/oneapi/compiler/2026.2/etc/compiler/sys_check/sys_check.sh'
ENV DPLROOT='/opt/intel/oneapi/dpl/2022.14'
ENV DPL_ROOT='/opt/intel/oneapi/dpl/2022.14'
ENV FI_PROVIDER_PATH='/opt/intel/oneapi/libfabric/2.6/lib/libfabric:/usr/lib64/libfabric'
ENV GDB_INFO='/opt/intel/oneapi/debugger/2026.2/share/info/'
ENV INFOPATH='/opt/intel/oneapi/debugger/2026.2/share/info'
ENV INTEL_PYTHONHOME='/opt/intel/oneapi/debugger/2026.2/opt/debugger'
ENV LD_LIBRARY_PATH='/opt/intel/oneapi/tcm/1.6/lib:/opt/intel/oneapi/umf/1.2/lib:/opt/intel/oneapi/tcm/1.6/env/../lib:/opt/intel/oneapi/tbb/2023.2/env/../lib/intel64/gcc4.8:/opt/intel/oneapi/pti/1.2/lib:/opt/intel/oneapi/mkl/2026.2/lib:/opt/intel/oneapi/libfabric/2.6/lib:/opt/intel/oneapi/debugger/2026.2/opt/debugger/lib:/opt/intel/oneapi/compiler/2026.2/opt/compiler/lib:/opt/intel/oneapi/compiler/2026.2/lib:/opt/intel/oneapi/ccl/2022.2/lib/'
ENV LIBFABRIC_ROOT='/opt/intel/oneapi/libfabric/2.6'
ENV LIBRARY_PATH='/opt/intel/oneapi/tcm/1.6/lib:/opt/intel/oneapi/umf/1.2/lib:/opt/intel/oneapi/tcm/1.6/env/../lib:/opt/intel/oneapi/tbb/2023.2/env/../lib/intel64/gcc4.8:/opt/intel/oneapi/pti/1.2/lib:/opt/intel/oneapi/mkl/2026.2/lib:/opt/intel/oneapi/compiler/2026.2/lib:/opt/intel/oneapi/ccl/2022.2/lib/'
ENV MANPATH='/opt/intel/oneapi/libfabric/2.6/share/man:/opt/intel/oneapi/debugger/2026.2/share/man:/opt/intel/oneapi/compiler/2026.2/share/man:'
ENV MKLROOT='/opt/intel/oneapi/mkl/2026.2'
ENV NLSPATH='/opt/intel/oneapi/compiler/2026.2/lib/compiler/locale/%l_%t/%N'
ENV OCL_ICD_FILENAMES='/opt/intel/oneapi/compiler/2026.2/lib/libintelocl.so'
ENV ONEAPI_ROOT='/opt/intel/oneapi'
ENV PATH='/opt/intel/oneapi/mkl/2026.2/bin:/opt/intel/oneapi/libfabric/2.6/bin:/opt/intel/oneapi/dev-utilities/2026.2/bin:/opt/intel/oneapi/debugger/2026.2/opt/debugger/bin:/opt/intel/oneapi/compiler/2026.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
ENV PKG_CONFIG_PATH='/opt/intel/oneapi/tbb/2023.2/env/../lib/pkgconfig:/opt/intel/oneapi/mkl/2026.2/lib/pkgconfig:/opt/intel/oneapi/libfabric/2.6/lib/pkgconfig:/opt/intel/oneapi/dpl/2022.14/lib/pkgconfig:/opt/intel/oneapi/compiler/2026.2/lib/pkgconfig:/opt/intel/oneapi/ccl/2022.2/lib/pkgconfig/'
ENV Pti_DIR='/opt/intel/oneapi/pti/1.2/lib/cmake/pti'
ENV SETVARS_COMPLETED='1'
ENV TBBROOT='/opt/intel/oneapi/tbb/2023.2/env/..'
ENV TCMROOT='/opt/intel/oneapi/tcm/1.6/env/..'
ENV TCM_ROOT='/opt/intel/oneapi/tcm/1.6'
ENV UMF_ROOT='/opt/intel/oneapi/umf/1.2'
